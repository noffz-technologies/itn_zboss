PLATFORM_DEFINES=-DZB_CONFIG_LINUX_NSNG

####### Common options

CC	=	gcc
#CC	=	cxref-cc
CXX	=	g++
LD      =       ld

#
# Configure trace by changing ZB_TRACE_MASK (one bit per layer)
# and ZB_TRACE_LEVEL (messages with layer > ZB_TRACE_LEVEL are unvisible).
# Do not define ZB_TRACE_LEVEL to switch off trace.

TRACE_DEFINES = -DZB_TRACE_LEVEL=3 -DZB_TRACE_MASK=0xFF18FFFC

CURRENT_DATE = $(shell date +"%Y%m%d")
DATE_DEFINE = -DZB_BUILD_DATE="\"$(CURRENT_DATE)\""

CURRENT_NCP_PROTOCOL_VERSION = 0x0115
NCP_PROTOCOL_VERSION_DEFINE = -DNCP_PROTOCOL_VERSION=$(CURRENT_NCP_PROTOCOL_VERSION)

DEBUG_DEFINES = -DDEBUG $(TRACE_DEFINES)

DEBUG_CFLAGS   = -g3 -O0

RELEASE_CFLAGS  = -O3

PROFILE_CFLAGS  = -g -O3 -pg

#WERROR = -Werror
WARN_OPTIONS = -W -Wall -Wpointer-arith -Wcast-align -Wformat=0 -std=gnu99 -Wno-format-zero-length -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast -Wno-unused-but-set-variable -Wdeclaration-after-statement -Wno-unused-local-typedefs  -Wno-missing-field-initializers -Wno-cast-function-type
WARN_OPTIONS_CXX = -W -Wall -Wpointer-arith -Wcast-align -pedantic

CFLAGS_BUILD_CFG = $(RELEASE_CFLAGS)

DEFINES = $(PLATFORM_DEFINES) $(DEBUG_DEFINES) $(DATE_DEFINE) $(NCP_PROTOCOL_VERSION_DEFINE)

CFLAGS = $(CFLAGS_BUILD_CFG) $(CFLAGS_USER) -pipe $(WARN_OPTIONS) -fno-strict-aliasing $(WERROR) -fshort-enums -ffunction-sections -fdata-sections
CXXFLAGS = $(CFLAGS_BUILD_CFG) $(CFLAGS_USER) -pipe $(WARN_OPTIONS_CXX) -fno-strict-aliasing $(WERROR) -fshort-enums

DEPSWITCH      = -MM
AR	=	ar
RM      =       rm -f
MAKE    =       make -e

MAKE_LIB    = $(AR) r $@ $^

PROF_FLAG=

LINK_FLAGS += -Wl,--gc-sections

LINK_BINARY = $(CC) $(PROF_FLAG) -o $@ $^ $(MEMDEBUG) -lpthread $(LINK_FLAGS) $(LIBS)
LINK_BINARY_SHARED = $(CC) $(PROF_FLAG) -shared -o $@ $^ $(MEMDEBUG) -lpthread $(LINK_FLAGS) $(LIBS) 
LINK_BINARY_ED = $(CC) $(PROF_FLAG) -o $@ $^ $(MEMDEBUG) -lpthread $(LINK_FLAGS) $(LIBS_ED)
LINK_BINARY_GPCB = $(CC) $(PROF_FLAG) -o $@ $^ $(MEMDEBUG) -lpthread $(LINK_FLAGS) $(LIBS_GPCB)

#
# Implicit rules
#

OBJ_SUFFIX=.o
EXE=
SHARED_LIB=.so
OBJS = ${SRCS:.c=.o}
OBJS_ED = ${SRCS:.c=.ed.o}
OBJS_ZGPD = ${SRCS:.c=.zgpd.o}
OBJS_SHARED = ${SRCS:.c=.shared.o}

.SUFFIXES: .cpp .c .o .ed.o .gpcb.o .shared.o .zgpd.o

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(DEFINES) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(DEFINES) $(INCPATH) -o $@ $<

.c.ed.o:
	$(CC) -c $(CFLAGS) $(DEFINES) -DZB_ED_ROLE $(INCPATH) -o $@ $<

.c.zgpd.o:
	$(CC) -c $(CFLAGS) $(DEFINES) -DZB_ZGPD_ROLE $(INCPATH) -o $@ $<

.c.gpcb.o:
	$(CC) -c $(CFLAGS) $(DEFINES) -DZB_ENABLE_ZGP_COMBO $(INCPATH) -o $@ $<

.c.shared.o:
	$(CC) -c $(CFLAGS) -fPIC $(DEFINES) $(INCPATH) -o $@ $<

bldall : all

clean: doclean

doclean:
	$(RM) *.o *.a core.* vgcore.* *~ */*.o src/*~ src/*.o include/*~ *.nvram *.log *.dump *.pcap $(BINS) $(OTHERS_CLEAN) $(TMP_SRCS)

PRETEST = echo

test:
	$(RM) *.log
	@for T in $(BINS_TEST) ; do \
		echo "Running test $$T ..." ; \
		[ A"$(PRETEST)" = A ] || $(PRETEST) ; \
		$(RM) *.log ; \
		./$$T ; \
		if test $$? -ne 0; then \
			echo "Error in test $$T" ; \
			exit -1 ; \
		fi ; \
		echo "ok" ; echo "" ; \
	done

rebuild: clean all

depend : $(SRCS)
	[ A"$(FAKE_DEPS)" = A ] || touch $(FAKE_DEPS)
	[ A"$(SRCS)" = A ] ||\
	$(CC) $(INCPATH) $(DEFINES) $(DEPSWITCH) $(SRCS) >> $(BUILD_HOME)/deps

# object dependencies
include $(BUILD_HOME)/deps
include $(BUILD_HOME)/Platform_config

#
# Modules definition: Libs & Includes
#

INCPATH = \
  -I$(BUILD_HOME)/include \
  -I$(BUILD_HOME)/include/osif \
  -I$(BUILD_HOME)/include/ha \
  -I$(BUILD_HOME)/include/zcl \

ZBOSS_LIB_PATH = $(BUILD_HOME)/lib

# ZBOSS libraries
ZBOSS_LIB = $(ZBOSS_LIB_PATH)/libzboss.a
ZBOSS_LIB_ED = $(ZBOSS_LIB_PATH)/libzboss.ed.a

#
# #####
#

LIBS = $(ZBOSS_LIB)

LIBS_ED = $(ZBOSS_LIB_ED)

