# PURPOSE:


CFLAGS=$(RELEASE_CFLAGS)

PLATFORM_DEFINES=-DZB_CONFIG_LINUX_NSNG

####### Common options

CC	=	gcc
#CC	=	cxref-cc
CXX	=	g++
LD      =       ld

#MEMDEBUG      = -lefence
#MEMDEBUG      = -ldl -lccmalloc /usr/lib/ccmalloc-g++.o -lccmalloc
MEMDEBUG      =
MOSQ_ARCH = host

#
# Configure trace by changing ZB_TRACE_MASK (one bit per layer)
# and ZB_TRACE_LEVEL (messages with layer > ZB_TRACE_LEVEL are unvisible).
# Do not define ZB_TRACE_LEVEL to switch off trace.

TRACE_DEFINES = -DZB_TRACE_LEVEL=4 -DZB_TRACE_MASK=0x0800

CURRENT_DATE = $(shell date +"%Y%m%d")
DATE_DEFINE = -DZB_BUILD_DATE="\"$(CURRENT_DATE)\""

CURRENT_NCP_PROTOCOL_VERSION = 0x0115
NCP_PROTOCOL_VERSION_DEFINE = -DNCP_PROTOCOL_VERSION=$(CURRENT_NCP_PROTOCOL_VERSION)

DEBUG_DEFINES = -DDEBUG $(TRACE_DEFINES)

DEBUG_CFLAGS   = -g3 -O0

RELEASE_CFLAGS  = -O3

PROFILE_CFLAGS  = -g -O3 -pg

#WERROR = -Werror
WARN_OPTIONS = -W -Wall -Wpointer-arith -Wcast-align -Wformat=0 -std=gnu99 -Wno-format-zero-length -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast -Wno-unused-but-set-variable -Wdeclaration-after-statement -Wno-unused-local-typedefs  -Wno-missing-field-initializers -Wno-unused-result

ifeq ($(MODE),werror)
    WARN_OPTIONS += -Werror
endif

WARN_OPTIONS_CXX = -W -Wall -Wpointer-arith -Wcast-align -pedantic

CFLAGS_BUILD_CFG = $(RELEASE_CFLAGS)

DEFINES = $(PLATFORM_DEFINES) $(DEBUG_DEFINES) $(DATE_DEFINE) $(NCP_PROTOCOL_VERSION_DEFINE)

CFLAGS = $(CFLAGS_BUILD_CFG) $(CFLAGS_USER) -pipe $(WARN_OPTIONS) -fno-strict-aliasing $(WERROR) -fshort-enums -ffunction-sections -fdata-sections
CXXFLAGS = $(CFLAGS_BUILD_CFG) $(CFLAGS_USER) -pipe $(WARN_OPTIONS_CXX) -fno-strict-aliasing $(WERROR) -fshort-enums

DEPSWITCH      = -MM
AR	=	ar
RM      =       rm -f
MAKE    =       make -e

MAKE_LIB    = $(AR) r $@ $^

PROF_FLAG=

LINK_FLAGS += -Wl,--gc-sections

ifeq ($(MODE),gcov)
    CFLAGS += --coverage 
    LINK_FLAGS += --coverage
endif 

# GCC option to generate map file
MAP_FLAGS = -Xlinker -Map=$@.map

LINK_FLAGS += $(MAP_FLAGS)

LINK_BINARY = $(CC) $(PROF_FLAG) -o $@ $^ $(MEMDEBUG) -lpthread $(LINK_FLAGS) $(LIBS) $(LIBS)
LINK_BINARY_ED = $(CC) $(PROF_FLAG) -o $@ $^ $(MEMDEBUG) -lpthread $(LINK_FLAGS) $(LIBS_ED) $(LIBS_ED)


#
# Implicit rules
#

OBJ_SUFFIX=.o
EXE=
OBJS = ${SRCS:.c=.o}
OBJS_ED = ${SRCS:.c=.ed.o}

.SUFFIXES: .cpp .c .o .ed.o .ut.o .u.o

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(DEFINES) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(DEFINES) $(INCPATH) -o $@ $<

.c.ed.o:
	$(CC) -c $(CFLAGS) $(DEFINES) -DZB_ED_ROLE $(INCPATH) -o $@ $<

.c.ut.o:
	$(CC) -c $(CFLAGS) $(DEFINES) $(INCPATH) -o $@ $<

.c.u.o:
	$(CC) -c $(CFLAGS) $(DEFINES) -DZB_TOOL $(INCPATH) -o $@ $<

bldall : all

clean: doclean

doclean:
	$(RM) *.o *.a core.* vgcore.* *~ */*.o src/*~ src/*.o include/*~ *.nvram *.log *.dump *.pcap $(BINS) $(OTHERS_CLEAN) $(TMP_SRCS)

PRETEST = echo

rebuild: clean all

depend : $(SRCS)
	[ A"$(FAKE_DEPS)" = A ] || touch $(FAKE_DEPS)
	[ A"$(SRCS)" = A ] ||\
	$(CC) $(INCPATH) $(DEFINES) $(DEPSWITCH) $(SRCS) >> $(BUILD_HOME)/deps

# object dependencies
include $(BUILD_HOME)/deps
include $(BUILD_HOME)/Platform_config

# ZBOSS
ZBOSS_LIB = $(BUILD_HOME)/lib/libzboss.a
ZBOSS_LIB_ED = $(BUILD_HOME)/lib/libzboss.ed.a

#
# Modules definition: Libs & Includes
#

# logger
COMMON_LIB = $(BUILD_HOME)/src/common/libcommon.a
COMMON_LIB_ED = $(BUILD_HOME)/src/common/libcommon.ed.a

COMMON_INC = $(BUILD_HOME)/include -I$(BUILD_HOME)/src/include

# osif
OSIF_INC = $(BUILD_HOME)/include/osif
OSIF_LIB = $(BUILD_HOME)/src/osif/libosif.a
OSIF_LIB_ED = $(BUILD_HOME)/src/osif/libosif.ed.a

# APS
APS_LIB = $(BUILD_HOME)/src/aps/libaps.a
APS_LIB_ED = $(BUILD_HOME)/src/aps/libaps.ed.a

# ZDO
ZDO_LIB = $(BUILD_HOME)/src/zdo/libzdo.a
ZDO_LIB_ED = $(BUILD_HOME)/src/zdo/libzdo.ed.a

# ZCL
ZCL_LIB = $(BUILD_HOME)/src/zcl/libzcl.a
ZCL_LIB_ED = $(BUILD_HOME)/src/zcl/libzcl.ed.a

# Security
SECUR_LIB = $(BUILD_HOME)/src/secur/libsec.a
SECUR_LIB_ED = $(BUILD_HOME)/src/secur/libsec.ed.a

#
# #####
#

INCPATH += -I$(OSIF_INC) -I$(COMMON_INC)

ZDO_LIB = $(BUILD_HOME)/src/zdo/libzdo.a
ZDO_LIB_ED = $(BUILD_HOME)/src/zdo/libzdo.ed.a

COMM_LEGACY_LIB = $(BUILD_HOME)/src/commissioning/legacy/libcommlegacy.a
COMM_LEGACY_LIB_ED = $(BUILD_HOME)/src/commissioning/legacy/libcommlegacy.ed.a

COMM_BDB_LIB = $(BUILD_HOME)/src/commissioning/bdb/libcommbdb.a
COMM_BDB_LIB_ED = $(BUILD_HOME)/src/commissioning/bdb/libcommbdb.ed.a

COMM_SE_LIB = $(BUILD_HOME)/src/commissioning/se/libcommse.a
COMM_SE_LIB_ED = $(BUILD_HOME)/src/commissioning/se/libcommse.ed.a

NCP_HOST_LIB = $(BUILD_HOME)/src/ncp/high_level/host/libncp_host.a
NCP_HOST_LIB_ED = $(BUILD_HOME)/src/ncp/high_level/host/libncp_host.ed.a

LIBS = \
	$(COMMON_LIB) \
	$(OSIF_LIB) \
	$(APS_LIB) \
	$(ZCL_LIB) \
	$(SECUR_LIB) \
	$(ZDO_LIB) \
	$(COMM_LEGACY_LIB) \
	$(COMM_BDB_LIB) \
	$(COMM_SE_LIB) \
	$(NCP_HOST_LIB)

LIBS_ED = \
	$(COMMON_LIB_ED) \
	$(OSIF_LIB_ED) \
	$(APS_LIB_ED) \
	$(ZCL_LIB_ED) \
	$(SECUR_LIB_ED) \
	$(ZDO_LIB_ED) \
	$(COMM_LEGACY_LIB_ED) \
	$(COMM_BDB_LIB_ED) \
	$(COMM_SE_LIB_ED) \
	$(NCP_HOST_LIB_ED)
